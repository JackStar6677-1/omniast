{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OmniAST",
  "scopeName": "source.omniast",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.omniast",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.omniast",
          "match": "//.*$"
        },
        {
          "name": "comment.block.omniast",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.omniast",
          "match": "\\b(module|entity|listener|sentinel|machine|pipeline|service)\\b"
        },
        {
          "name": "keyword.control.omniast",
          "match": "\\b(on|priority|guard|cancel|route|notify|alert|log|if|else)\\b"
        },
        {
          "name": "keyword.modifier.omniast",
          "match": "\\b(primary|unique|required|default|max|persist)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.omniast",
          "match": "\\b(string|int|long|float|double|decimal|boolean|uuid|item|location|actor|entity|event|duration|list|map)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.omniast",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.omniast",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.omniast",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.omniast",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.omniast",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.omniast",
          "match": "\\b\\d+[smhdw]\\b"
        },
        {
          "name": "constant.numeric.unit.omniast",
          "match": "\\b\\d+(\\.\\d+)?\\s*(J|J/s|B|KB|MB|GB|TB|ops|req/s|tps)\\b"
        },
        {
          "name": "constant.numeric.decimal.omniast",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.omniast",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.omniast",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.omniast",
          "match": "(=|->|:|\\+|-|\\*|/|==|!=|<=|>=|<|>|&&|\\|\\||!)"
        }
      ]
    }
  }
}
